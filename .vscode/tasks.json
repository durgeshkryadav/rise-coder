{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Enter commit message",
      "default": "update"
    }
  ],
  "tasks": [
        {
      "label": "npm run dev",
      "type": "shell",
      "command": "npm run dev",
    },
    {
      "label": "git add",
      "type": "shell",
      "command": "git",
      "args": ["add", "."],
      "problemMatcher": []
    },
    {
      "label": "git commit",
      "type": "shell",
      "command": "git",
      "args": [
        "commit",
        "-m",
        "${input:commitMessage}"
      ],
      "problemMatcher": []
    }
  ]
}